# ==========================================
# ANDIKA Frontend Environment Variables
# ==========================================
# Copy this file to .env and fill in the actual values
# Never commit .env to version control

# ==========================================
# Supabase Configuration
# ==========================================
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ==========================================
# Backend API Configuration
# ==========================================
# Backend API URL (without /api/v1 suffix)
# Local development: http://localhost:3001
# Production: your backend domain or load balancer URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# ==========================================
# Application Configuration
# ==========================================
# Next.js configuration
NEXT_PUBLIC_APP_NAME=ANDIKA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Google OAuth (via Supabase)
# ==========================================
# Google OAuth is configured in Supabase, not here
# See docs/ENVIRONMENT_SETUP.md for Google OAuth setup instructions
# No additional environment variables needed for Google OAuth
