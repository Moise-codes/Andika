# ==========================================
# ANDIKA Backend Environment Variables
# ==========================================
# Copy this file to .env and fill in the actual values
# Never commit .env to version control

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
NODE_ENV=development

# Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=http://localhost:3000

# ==========================================
# Supabase Configuration
# ==========================================
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==========================================
# Database Configuration (Prisma)
# ==========================================
# DATABASE_URL - Use Transaction Pooler for Prisma (recommended for production)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# DIRECT_URL - Use Direct Connection (no pooler) for migrations
# Required for Prisma migrations and operations that need direct DB access
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# ==========================================
# Email Configuration (Optional - for password reset)
# ==========================================
# SMTP settings for sending emails (e.g., password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@andika.app

# ==========================================
# JWT Configuration (Optional - if using custom JWT)
# ==========================================
# Only needed if you implement custom JWT signing
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=7d

# ==========================================
# Rate Limiting
# ==========================================
# Configured in app.module.ts but can be overridden
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=120
